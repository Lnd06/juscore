{
  "name": "juscore-ai-production",
  "version": "1.6.5",
  "description": "JusCore AI Final Build",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend && npm install --prefix frontend-master",
    "dev:client": "npm run dev --prefix frontend",
    "dev:master": "npm run dev --prefix frontend-master",
    "build:client": "npm run build --prefix frontend",
    "build:master": "npm run build --prefix frontend-master",
    "install-prod": "cd backend && npm install"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "groq-sdk": "^0.3.3",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.12.0",
    "mongoose": "^8.23.0",
    "multer": "^2.0.2",
    "mysql2": "^3.17.1",
    "nodemailer": "^8.0.1",
    "p-queue": "^9.1.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "ssh2": "^1.17.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
