# ======================================
# JUSCORE AI - CONFIGURAÇÃO
# ======================================
# COPIE este arquivo para .env e preencha com seus valores reais

# Servidor
PORT=3000
NODE_ENV=development

# Segurança (mínimo 32 caracteres)
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres

# IA - Groq API (https://console.groq.com)
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Banco de Dados MySQL
DB_HOST=localhost
DB_NAME=juscore_ai
DB_USER=root
DB_PASS=sua_senha_mysql

# E-mail (Nodemailer - Gmail com App Password)
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_app_gmail

# Configurações Opcionais
MAX_TEXTO_PLANALTO=8000